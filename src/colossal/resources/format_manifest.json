        "jpg": {
          "label": "JPEG Image",
          "extensions": [".jpg", ".jpeg"],
          "mime": "image/jpeg",
          "lossy": true
        },
        "ico": {
          "label": "ICO Image",
          "extensions": [".ico"],
          "mime": "image/x-icon",
          "lossy": false
