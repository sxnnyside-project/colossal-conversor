/* ==========================================================================
   Colossal Conversor v4 — Windows 95-Inspired Classic Blue Design System
   ========================================================================== */

QWidget {
    background-color: #d4d0c8;
    color: #000000;
    font-family: "Segoe UI", "Tahoma", "Helvetica Neue", "Arial", "MS UI Gothic", "SimSun", sans-serif;
    font-size: 12px;
}

/* --- System Header Bar --- */
QWidget#headerBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #000080, stop:1 #1084d0);
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    padding: 6px 10px;
}

QLabel#appIcon {
    background: transparent;
    padding-right: 6px;
}

QLabel#title {
    color: #ffffff;
    font-size: 15px;
    font-weight: bold;
    background: transparent;
}

QLabel#versionBadge {
    color: #ffd700;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
    padding-left: 4px;
}

QLabel#langLabel {
    color: #ffffff;
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

/* --- Panels & Cards --- */
QWidget#card {
    background-color: #d4d0c8;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
}

QWidget#sunkenBox {
    background-color: #ffffff;
    color: #000000;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    padding: 6px;
}

/* --- Standard 3D Beveled Buttons --- */
QPushButton {
    background-color: #d4d0c8;
    color: #000000;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    padding: 5px 12px;
    min-height: 22px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #dfdfdf;
}

QPushButton:pressed {
    background-color: #c0c0c0;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    padding: 6px 11px 4px 13px;
}

QPushButton:checked {
    background-color: #000080;
    color: #ffffff;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
}

QPushButton:disabled {
    color: #888888;
    background-color: #d4d0c8;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #a0a0a0;
    border-bottom: 2px solid #a0a0a0;
}

QPushButton:focus {
    outline: 1px dotted #000000;
}

/* --- Primary Convert Button --- */
QPushButton#convertBtn {
    background-color: #004080;
    color: #ffffff;
    border-top: 2px solid #80a0ff;
    border-left: 2px solid #80a0ff;
    border-right: 2px solid #002040;
    border-bottom: 2px solid #002040;
    font-size: 13px;
    font-weight: bold;
    min-height: 26px;
    padding: 6px 16px;
}

QPushButton#convertBtn:hover {
    background-color: #1066cc;
}

QPushButton#convertBtn:pressed {
    background-color: #003060;
    border-top: 2px solid #002040;
    border-left: 2px solid #002040;
    border-right: 2px solid #80a0ff;
    border-bottom: 2px solid #80a0ff;
}

QPushButton#convertBtn:disabled {
    background-color: #8090a0;
    color: #d0d0d0;
    border-top: 2px solid #b0c0d0;
    border-left: 2px solid #b0c0d0;
    border-right: 2px solid #506070;
    border-bottom: 2px solid #506070;
}

/* --- Cancel Button --- */
QPushButton#cancelBtn {
    background-color: #d4d0c8;
    color: #990000;
}

QPushButton#cancelBtn:hover {
    background-color: #ffebee;
}

QPushButton#cancelBtn:pressed {
    background-color: #ffcdd2;
}

/* --- Combo Boxes & Inputs --- */
QComboBox {
    background-color: #ffffff;
    color: #000000;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    padding: 4px 6px;
    min-height: 20px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 18px;
    border-left: 1px solid #808080;
    border-top: 1px solid #ffffff;
    border-right: 1px solid #808080;
    border-bottom: 1px solid #808080;
    background-color: #d4d0c8;
}

QComboBox::drop-down:pressed {
    border-left: 1px solid #808080;
    border-top: 1px solid #808080;
    border-right: 1px solid #ffffff;
    border-bottom: 1px solid #ffffff;
    background-color: #c0c0c0;
}

QComboBox::down-arrow {
    image: url("__ARROW_DOWN_PATH__");
    width: 9px;
    height: 9px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #000000;
    selection-background-color: #000080;
    selection-color: #ffffff;
    border: 1px solid #808080;
}

QTextEdit, QLineEdit, QScrollArea {
    background-color: #ffffff;
    color: #000000;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    padding: 4px;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #ffffff;
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    height: 18px;
    text-align: center;
    color: #000000;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #000080;
}

/* --- Semantic Badges --- */
QLabel#badge {
    background-color: #e3f2fd;
    color: #004080;
    border: 1px solid #2196f3;
    padding: 3px 6px;
    font-weight: bold;
    font-size: 11px;
}

QLabel#warning {
    background-color: #fffde7;
    color: #804000;
    border: 1px solid #ffb300;
    padding: 3px 6px;
    font-weight: bold;
    font-size: 11px;
}

QLabel#limitation {
    background-color: #fff3e0;
    color: #e65100;
    border: 1px solid #ff9800;
    padding: 3px 6px;
    font-weight: bold;
    font-size: 11px;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #ffffe1;
    color: #000000;
    border: 1px solid #000000;
    padding: 3px 6px;
}
