/* Material-like theme for Colossal Conversor */
/* Palette
   accent: #43dee7
   primary: #1c6282
   on-primary (icons/text on accent): #ffffff
   surface: #ffffff
   background: #f6feff
*/

QWidget {
  background: #f6feff;
  color: #1c6282;
  font-family: "Segoe UI", "Roboto", "Helvetica Neue", "Arial";
  font-size: 13px;
}

/* Topbar */
QLabel#title {
  color: #1c6282;
  font-weight: 700;
  font-size: 20px;
  padding-left: 8px;
}

/* Card */
QWidget#card {
  background: #ffffff;
  border: 1px solid rgba(28,98,130,0.06);
  border-radius: 14px;
  padding: 16px;
}

/* Topbar container tweak */
QMainWindow > QWidget > QVBoxLayout > QHBoxLayout { }

/* App icon label: give space and rounding when used as icon */
QLabel {
  color: #1c6282;
}

/* Elevated primary button */
QPushButton {
  background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #52e7ea, stop:1 #43dee7);
  color: #ffffff;
  border: none;
  border-radius: 12px;
  padding: 10px 16px;
  min-height: 36px;
  font-weight: 600;
}
QPushButton:hover { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4fe0e8, stop:1 #36cfc7); }
QPushButton:pressed { background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2ecfd6, stop:1 #1fb9c1); }
QPushButton:disabled {
  background: #e8f7f7;
  color: #9bb6be;
}

/* Secondary flat button */
QPushButton[flat="true"] {
  background: transparent;
  color: #1c6282;
}

/* File-open button special style */
QPushButton#fileIconBtn {
  background: #43dee7;
  border-radius: 12px;
  border: none;
  color: #ffffff;
}
QPushButton#fileIconBtn:hover { background: #36cfc7; }
QPushButton#fileIconBtn:pressed { background: #2ea6a0; }

/* Compact combos and inputs */
QComboBox, QLineEdit, QTextEdit, QSpinBox {
  background: #ffffff;
  color: #1c6282;
  border: 1px solid #e0f3f4;
  border-radius: 8px;
  padding: 6px 8px;
}
QComboBox QAbstractItemView { background: #ffffff; color: #1c6282; }

/* Badges */
QLabel#badge { background: #43dee7; color: #fff; padding: 6px 10px; border-radius: 999px; font-weight: 700; }
QLabel#warning { background: #fff7f2; color: #b03a1a; border: 1px solid #ffd6c7; border-radius: 8px; padding: 6px; }
QLabel#limitation { background: #fffdf0; color: #7a5a00; border: 1px solid #fff1c0; border-radius: 8px; padding: 6px; }

/* Hints area */
QTextEdit#hintsText { background: #f3ffff; border-radius: 8px; border: 1px solid #e9fbfb; color: #1c6282; padding: 10px; }
QTextEdit#hintsTextWarning { background: #fff7f2; color: #b03a1a; border: 1px solid #ffd6c7; }

/* Progress */
QProgressBar { background: #f0fbfb; border-radius: 8px; border: 1px solid #e0f3f4; height: 14px; color: #1c6282; }
QProgressBar::chunk { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #43dee7, stop:1 #2ecfd6); border-radius: 8px; }

/* Tooltips */
QToolTip { background: #1c6282; color: #fff; border-radius: 6px; padding: 6px; }

/* End */
