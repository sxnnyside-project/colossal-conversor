{
  "category": "video",
  "formats": [
    "mp4",
    "mkv",
    "mov",
    "avi",
    "webm",
    "flv",
    "wmv",
    "gif"
  ],
  "engines": {
    "transcoder": "ffmpeg",
    "ffmpeg": "ffmpeg"
  },
  "conversions": [
    {
      "name": "VideoToMP4Converter",
      "from": ["mp4", "mov", "avi", "mkv", "webm", "flv", "wmv"],
      "to": "mp4",
      "engine": "ffmpeg",
      "mode": "transcode",
      "fidelity": "high",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.mp4"
      }
    },
    {
      "name": "VideoToMKVConverter",
      "from": ["mp4", "mov", "avi", "webm", "flv", "wmv"],
      "to": "mkv",
      "engine": "ffmpeg",
      "mode": "remux_or_transcode",
      "fidelity": "source",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.mkv"
      }
    },
    {
      "name": "VideoToMOVConverter",
      "from": ["mp4", "mkv", "avi", "webm", "flv", "wmv"],
      "to": "mov",
      "engine": "ffmpeg",
      "mode": "transcode",
      "fidelity": "high",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.mov"
      }
    },
    {
      "name": "VideoToAVIConverter",
      "from": ["mp4", "mkv", "mov", "webm", "flv", "wmv"],
      "to": "avi",
      "engine": "ffmpeg",
      "mode": "legacy_transcode",
      "fidelity": "medium",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.avi"
      }
    },
    {
      "name": "VideoToWebMConverter",
      "from": ["mp4", "mkv", "mov", "avi", "flv", "wmv"],
      "to": "webm",
      "engine": "ffmpeg",
      "mode": "transcode",
      "fidelity": "high",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.webm"
      }
    },
    {
      "name": "VideoToGIFConverter",
      "from": ["mp4", "mkv", "mov", "avi", "webm"],
      "to": "gif",
      "engine": "ffmpeg",
      "mode": "animation_convert",
      "fidelity": "medium",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.gif"
      }
    }
  ]
}
