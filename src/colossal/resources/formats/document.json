{
  "category": "document",
  "formats": [
    "doc",
    "docx",
    "odt",
    "rtf",
    "txt",
    "pdf",
    "md",
    "html",
    "epub"
  ],
  "engines": {
    "office": "soffice",
    "markdown": "pandoc",
    "pdf": "soffice",
    "poppler": "pdftoppm"
  },
  "conversions": [
    {
      "name": "DocumentToPDFConverter",
      "from": [
        "doc",
        "docx",
        "odt",
        "rtf",
        "txt",
        "html",
        "md"
      ],
      "to": "pdf",
      "engine": "office",
      "mode": "render",
      "fidelity": "layout",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.pdf"
      }
    },
    {
      "name": "MarkdownToDocumentConverter",
      "from": [
        "md",
        "txt"
      ],
      "to": [
        "html",
        "docx",
        "odt",
        "rtf",
        "epub",
        "pdf"
      ],
      "engine": "markdown",
      "mode": "render",
      "fidelity": "semantic",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    },
    {
      "name": "DocumentToMarkdownConverter",
      "from": [
        "doc",
        "docx",
        "odt",
        "rtf",
        "html",
        "epub",
        "txt"
      ],
      "to": [
        "md",
        "txt",
        "html"
      ],
      "engine": "markdown",
      "mode": "extract",
      "fidelity": "semantic",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    },
    {
      "name": "HTMLToDocumentConverter",
      "from": [
        "html",
        "htm"
      ],
      "to": [
        "pdf",
        "docx",
        "odt",
        "rtf",
        "md",
        "txt"
      ],
      "engine": "office",
      "mode": "render",
      "fidelity": "semantic",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    },
    {
      "name": "DocumentToDocumentConverter",
      "from": [
        "doc",
        "docx",
        "odt",
        "rtf",
        "txt",
        "html"
      ],
      "to": [
        "docx",
        "odt",
        "rtf",
        "txt",
        "html",
        "pdf"
      ],
      "engine": "office",
      "mode": "transcode",
      "fidelity": "layout",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    },
    {
      "name": "PDFToImagesConverter",
      "from": "pdf",
      "to": [
        "png",
        "jpeg",
        "tiff"
      ],
      "engine": "poppler",
      "mode": "render",
      "fidelity": "lossless",
      "output": {
        "type": "multi_file",
        "pattern": "{input_name_no_ext}_page_{page_num}.{target_ext}"
      }
    }
  ]
}
