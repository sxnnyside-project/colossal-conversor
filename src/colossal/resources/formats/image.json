{
  "category": "image",
  "formats": [
    "png",
    "jpeg",
    "webp",
    "bmp",
    "tiff",
    "gif",
    "ico",
    "svg",
    "ppm",
    "tga"
  ],
  "engines": {
    "native": "native_image",
    "default": "magick",
    "svg": "magick",
    "gif": "magick"
  },
  "conversions": [
    {
      "name": "ImageToPNGConverter",
      "from": ["png", "jpeg", "webp", "bmp", "tiff", "gif", "ico", "ppm", "tga"],
      "to": "png",
      "engine": "default",
      "mode": "raster_convert",
      "fidelity": "high",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.png"
      }
    },
    {
      "name": "ImageToJPEGConverter",
      "from": ["png", "jpeg", "webp", "bmp", "tiff", "gif", "ico", "ppm", "tga"],
      "to": "jpeg",
      "engine": "default",
      "mode": "lossy_convert",
      "fidelity": "medium",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.jpeg"
      }
    },
    {
      "name": "ImageToWebPConverter",
      "from": ["png", "jpeg", "bmp", "tiff", "gif", "ico", "ppm", "tga"],
      "to": "webp",
      "engine": "default",
      "mode": "lossy_or_lossless",
      "fidelity": "high",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.webp"
      }
    },
    {
      "name": "ImageToBMPConverter",
      "from": ["png", "jpeg", "webp", "bmp", "tiff", "gif", "ico", "ppm", "tga"],
      "to": "bmp",
      "engine": "native",
      "mode": "raster_convert",
      "fidelity": "lossless",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.bmp"
      }
    },
    {
      "name": "ImageToTIFFConverter",
      "from": ["png", "jpeg", "webp", "bmp", "gif", "ppm", "tga"],
      "to": "tiff",
      "engine": "default",
      "mode": "lossless",
      "fidelity": "high",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.tiff"
      }
    },
    {
      "name": "ImageToGIFConverter",
      "from": ["png", "jpeg", "webp", "bmp", "tiff"],
      "to": "gif",
      "engine": "gif",
      "mode": "raster_convert",
      "fidelity": "medium",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.gif"
      }
    },
    {
      "name": "ImageToICOConverter",
      "from": ["png", "jpeg", "bmp", "webp"],
      "to": "ico",
      "engine": "default",
      "mode": "icon_convert",
      "fidelity": "high",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.ico"
      }
    },
    {
      "name": "ImageToPPMConverter",
      "from": ["bmp", "ppm", "tga", "png", "jpeg"],
      "to": "ppm",
      "engine": "native",
      "mode": "raw_convert",
      "fidelity": "lossless",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.ppm"
      }
    },
    {
      "name": "ImageToTGAConverter",
      "from": ["bmp", "ppm", "tga", "png", "jpeg"],
      "to": "tga",
      "engine": "native",
      "mode": "raw_convert",
      "fidelity": "lossless",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.tga"
      }
    },
    {
      "name": "SVGToImageConverter",
      "from": "svg",
      "to": ["png", "jpeg", "webp", "bmp"],
      "engine": "svg",
      "mode": "vector_rasterize",
      "fidelity": "high",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    }
  ]
}
