{
  "category": "audio",
  "formats": [
    "mp3",
    "wav",
    "flac",
    "aac",
    "ogg",
    "m4a",
    "amr",
    "opus",
    "aiff",
    "wma"
  ],
  "engine": "ffmpeg",
  "conversions": [
    {
      "name": "AudioToMP3Converter",
      "from": "*",
      "to": "mp3",
      "engine": "ffmpeg",
      "mode": "transcode",
      "fidelity": "medium",
      "output": {
        "type": "single_file",
        "pattern": "{input_name_no_ext}.mp3"
      }
    },
    {
      "name": "AudioToWAVConverter",
      "from": "*",
      "to": "wav",
      "engine": "ffmpeg",
