{
  "category": "slide",
  "formats": [
    "pptx",
    "ppt",
    "odp",
    "pdf",
    "html"
  ],
  "engines": {
    "office": "soffice",
    "soffice": "soffice",
    "poppler": "pdftoppm"
  },
  "conversions": [
    {
      "name": "SlideToPDFConverter",
      "from": ["pptx", "ppt", "odp"],
      "to": "pdf",
      "engine": "soffice",
      "mode": "semantic",
      "fidelity": "high",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.pdf"
      }
    },
    {
      "name": "SlideToSlideConverter",
      "from": ["pptx", "ppt", "odp"],
      "to": ["pptx", "odp", "html"],
      "engine": "soffice",
      "mode": "transcode",
      "fidelity": "high",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    },
    {
      "name": "SlideToImagesConverter",
      "from": ["pptx", "ppt", "odp"],
      "to": ["png", "jpeg"],
      "engine": "soffice",
      "mode": "render",
      "fidelity": "high",
      "output": {
        "type": "multi_file",
        "pattern": "{input_name_no_ext}_page_{page_num}.{target_ext}"
      }
    }
  ]
}