{
  "category": "slide",
  "formats": [
    "pptx",
    "ppt",
    "odp",
    "pdf",
    "html",
    "jpg",
    "png",
    "tiff",
    "webp"
  ],
  "conversions": [
    {
      "name": "PowerPointToPDFConverter",
      "from": "pptx",
      "to": "pdf",
      "engine": "soffice",
      "mode": "semantic",
      "fidelity": "high",
      "output": {
        "type": "single",
        "pattern": "{input_name_no_ext}.pdf"
      }
    },
    {
      "name": "PowerPoint97ToPDFConverter",
      "from": "ppt",
      "to": "pdf",
      "engine": "soffice",
      "mode": "semantic",
      "fidelity": "medium",
      "output": {
        "type": "single",
        "pattern": "{input_name_no_ext}.pdf"
      }
    },
    {
      "name": "OpenDocumentPresentationToPDFConverter",
      "from": "odp",
      "to": "pdf",
      "engine": "soffice",
      "mode": "semantic",
      "fidelity": "high",
      "output": {
        "type": "single",
        "pattern": "{input_name_no_ext}.pdf"
      }
    },
    {
      "name": "PDFToSlideConverter",
      "from": "pdf",
      "to": "pptx, ppt, odp",
      "engine": "soffice",
      "mode": "visual",
      "fidelity": "low",
      "output": {
        "type": "single",
        "pattern": "{input_name_no_ext}.{output_ext}"
      }
    },
    {
      "name": "SlideToHTMLConverter",
      "from": ["pptx", "ppt", "odp"],
      "to": "html",
      "engine": "soffice",
      "mode": "visual",
      "fidelity": "experimental",
      "output": {
        "type": "single",
        "pattern": "{input_name_no_ext}.html"
      }
    },
    {
      "name": "HTMLToSlideConverter",
      "from": "html",
      "to": ["pptx", "ppt", "odp"],
      "engine": "soffice",
      "mode": "semantic",
      "fidelity": "low",
      "output": {
        "type": "single",
        "pattern": "{input_name_no_ext}.{output_ext}"
      }
    },
    {
      "name": "SlideToImageConverter",
      "from": ["pptx", "ppt", "odp", "pdf"],
      "to": ["jpeg", "png", "tiff", "webp"],
      "engine": "poppler",
      "mode": "render",
      "fidelity": "high",
      "output": {
        "type": "mutli",
        "multi_page": true,
        "pattern": "{input_name_no_ext}_page_{page_number}.{output_ext}"
      }
    }
  ]
}