{
  "category": "sheet",
  "formats": ["xls", "xlsx", "ods", "csv", "tsv", "pdf", "html"],
  "engines": {
    "office": "soffice",
    "soffice": "soffice"
  },
  "conversions": [
    {
      "name": "SheetToPDFConverter",
      "from": ["xls", "xlsx", "ods", "csv", "tsv"],
      "to": "pdf",
      "engine": "soffice",
      "mode": "layout_export",
      "fidelity": "high",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.pdf"
      }
    },
    {
      "name": "SheetToTabularConverter",
      "from": ["xls", "xlsx", "ods"],
      "to": ["csv", "tsv"],
      "engine": "soffice",
      "mode": "flatten_sheets",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    },
    {
      "name": "TabularToSheetConverter",
      "from": ["csv", "tsv"],
      "to": ["xlsx", "ods"],
      "engine": "soffice",
      "mode": "sheet_import",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    },
    {
      "name": "SheetToSheetConverter",
      "from": ["xls", "xlsx", "ods", "csv", "tsv"],
      "to": ["xlsx", "ods", "csv", "html"],
      "engine": "soffice",
      "mode": "native_convert",
      "fidelity": "high",
      "output": {
        "type": "file",
        "pattern": "{input_name_no_ext}.{target_ext}"
      }
    }
  ]
}
